# LAZULA.ai settings. Copy to .env for local development. Never commit .env.
# Every value here is fake and only valid for local development and tests.

LAZULA_ENV=development            # development | test | staging | production
LOG_LEVEL=INFO

# Database (MySQL 8 in staging/production; SQLite is fine for local experiments)
DATABASE_URL=mysql+asyncmy://lazula:lazula@127.0.0.1:3306/lazula_ai

# Redis (replay protection, idempotency cache, queues)
REDIS_URL=redis://127.0.0.1:6379/0

# Master encryption key: 32 random bytes, base64. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# In staging/production use MASTER_KEY_FILE=/run/secrets/master_key instead.
MASTER_KEY=ZGV2LW9ubHktZmFrZS1tYXN0ZXIta2V5LTMyYnl0ZXM=
MASTER_KEY_ID=k1

# Request signing window in seconds
SIGNATURE_MAX_SKEW_SECONDS=300

# Idempotency: how long completed results are kept for safe retries (seconds)
RESULT_CACHE_TTL_SECONDS=86400

# Provider keys are NOT set here. Add them to the encrypted vault with:
#   uv run python -m app.cli add-provider-key anthropic

# Admin console: only these emails may hold an admin account or sign in (comma-separated).
# Empty means nobody (fails closed). Default: dev@lazula.net,ryan@orrhomes.com (AD-038).
ADMIN_ALLOWED_EMAILS=dev@lazula.net,ryan@orrhomes.com
